<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".DogGuideApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.DogGuide">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.LoginActivity"
            android:parentActivityName=".presentation.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.BreedDetailsActivity"
            android:parentActivityName=".presentation.MainActivity" />
        <activity
            android:name=".presentation.FavoritesActivity"
            android:parentActivityName=".presentation.MainActivity" />
        <activity
            android:name=".presentation.RecognizeActivity"
            android:parentActivityName=".presentation.MainActivity" />
    </application>

</manifest>
